# Copy thành .env.local rồi điền giá trị. Không commit .env.local.

# Auth0 — bắt buộc để tính năng login/profile hoạt động
# Lấy từ https://manage.auth0.com → Applications → Settings
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Base URL của app (dev: http://localhost:3000)
APP_BASE_URL=

# Supabase — bắt buộc để tính năng comments hoạt động
# Lấy từ https://supabase.com → Project Settings
#   URL:             https://<Project ID>.supabase.co (Project ID ở General hoặc trên thanh địa chỉ)
#   Publishable key: API Keys → Publishable key (sb_publishable_...) — public, tôn trọng RLS
#   Secret key:      API Keys → Secret keys (sb_secret_...) — CHỈ server, bypass RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AccessTrade — chỉ dùng phía server (KHÔNG thêm tiền tố NEXT_PUBLIC_)
# Lấy từ https://pub2.accesstrade.vn/profile/api_key
ACCESSTRADE_API_KEY=

# Google Analytics 4 (Measurement ID)
NEXT_PUBLIC_GA_ID=
